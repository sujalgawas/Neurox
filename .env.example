# Alpaca paper-trading credentials.
ALPACA_API_KEY=YOUR_API_KEY
ALPACA_SECRET_KEY=YOUR_API_KEY

# Alpaca paper endpoint (do not use a live-trading URL for this prototype).
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# JEV API credentials and OpenAI-compatible chat-completions URL.
JEV_API_KEY=YOUR_API_KEY
JEV_API_URL=https://<jev-api-host>/<endpoint>
JEV_MODEL=<model_name>

# Hugging Face token for downloading the JEPA checkpoint.
HUGGINGFACE_KEY=YOUR_HUGGINGFACE_TOKEN

# Path to the trained JEPA direction checkpoint. When set, this takes precedence
# over downloading the checkpoint from Hugging Face.
JEPA_CHECKPOINT=checkpoints/direction_head.pt
JEPA_HF_REVISION=858439ff868c21a15d1766dac84f378c40081ba3
jepa_train_cutoff=2025-01-01T00:00:00+00:00
combined_signal_log_path=data/combined/signals.jsonl

# Combined pipeline rule/risk settings. Percentile history is kept in memory per process.
COMBINED_PERCENTILE_WINDOW=500
COMBINED_JEPA_WEIGHT=0.5
COMBINED_JEV_WEIGHT=0.5
COMBINED_ENTRY_THRESHOLD=0.6
COMBINED_SOLO_THRESHOLD=0.85
COMBINED_MAX_SIZE=1.0
COMBINED_WARMUP_PERIOD=2
